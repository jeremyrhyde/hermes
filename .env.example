# Hermes environment overrides. Copy to `.env` (which is gitignored) and edit.
# Read by config.py at startup; every value below is optional.

# --- Server (FastAPI) settings — all optional, defaults shown -------------
#HOST=0.0.0.0
#PORT=8002
#LOG_LEVEL=info
#WEB_DIR=./web

# --- Feed pipeline -------------------------------------------------------
#DB_PATH=./hermes.db
#SOURCES_CONFIG_PATH=./sources.yaml

# The hand-written taste profile, seeded into the database on first run.
# Gitignored like sources.yaml — copy profile.md.example to start. Without it
# the server still boots and summarizes; articles just stay unscored, and
# /health says so.
#PROFILE_PATH=./profile.md

# Required for summarization and scoring. Get one at https://console.anthropic.com/
#ANTHROPIC_API_KEY=sk-ant-...
#SUMMARY_MODEL=claude-haiku-4-5
#SUMMARY_MAX_INPUT_CHARS=60000
# Scoring is a judgment call against a rubric, so it runs on a larger model.
#SCORE_MODEL=claude-sonnet-5

# Poller: how often the loop wakes, and the per-source interval clamp.
#POLL_TICK_SECONDS=60
#POLL_MIN_SECONDS=900
#POLL_MAX_SECONDS=14400

# Seed values only — the live knobs are stored in the `preferences` table
# and edited from the UI. Changing these after first run has no effect.
# The cutoff seeds to 0 — calibration mode, where nothing is hidden until the
# scores have been read against real articles.
#DEFAULT_SCORE_CUTOFF=0
#DEFAULT_MAX_DISPLAYED=50
