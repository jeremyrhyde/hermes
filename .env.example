# Hermes environment overrides. Copy to `.env` (which is gitignored) and edit.
# Read by config.py at startup; every value below is optional.

# --- Server (FastAPI) settings — all optional, defaults shown -------------
#HOST=0.0.0.0
#PORT=8000
#LOG_LEVEL=info
#WEB_DIR=./web

# --- Feed pipeline -------------------------------------------------------
#DB_PATH=./hermes.db
#SOURCES_CONFIG_PATH=./sources.yaml

# Required for summarization. Get one at https://console.anthropic.com/
#ANTHROPIC_API_KEY=sk-ant-...
#SUMMARY_MODEL=claude-haiku-4-5
#SUMMARY_MAX_INPUT_CHARS=60000

# Poller: how often the loop wakes, and the per-source interval clamp.
#POLL_TICK_SECONDS=60
#POLL_MIN_SECONDS=900
#POLL_MAX_SECONDS=14400

# Seed values only — the live knobs are stored in the `preferences` table
# and edited from the UI. Changing these after first run has no effect.
#DEFAULT_SCORE_CUTOFF=70
#DEFAULT_MAX_DISPLAYED=5
